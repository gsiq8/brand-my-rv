# Public URL of your site (used for Stripe redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project settings > API). The service role key is SECRET: server only, never expose it.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Developers > API keys, and the webhook signing secret)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Long random string that protects /admin and /api/admin/*
ADMIN_SECRET=change-me-to-a-long-random-string
